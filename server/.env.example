NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/airline_booking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m

# Rate Limiter (requests per window, window in seconds)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GUEST=20
RATE_LIMIT_USER=100

# Seat Lock
SEAT_LOCK_TTL_SEC=300

# CORS
CLIENT_URL=http://localhost:5173

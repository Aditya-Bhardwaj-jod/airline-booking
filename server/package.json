{
    "name": "airline-booking-server",
    "version": "1.0.0",
    "description": "Production-grade airline ticket booking system backend",
    "main": "src/server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node -e \"try{require('./src/server.js')}catch(e){console.error('ERR:',e.message);process.exit(1)}\"",
        "dev": "nodemon src/server.js",
        "test": "jest --runInBand --detectOpenHandles"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-mongo-sanitize": "^2.2.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.4.1",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.0",
        "morgan": "^1.10.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.13.1"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.4",
        "supertest": "^7.2.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}